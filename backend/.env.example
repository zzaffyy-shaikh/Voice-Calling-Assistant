# --- App ---
DEBUG=True
API_BASE_URL=http://localhost:8000
VOICE_WEBHOOK_SECRET=changeme

# --- Database ---
# Used by the FastAPI app (async driver). When running via docker-compose,
# host "db" resolves to the postgres container. When running locally against
# docker-compose's Postgres, use host "localhost" instead.
DATABASE_URL=postgresql+asyncpg://voiceai:voiceai@db:5432/voiceai

# --- Postgres container settings (docker-compose reads these) ---
POSTGRES_USER=voiceai
POSTGRES_PASSWORD=voiceai
POSTGRES_DB=voiceai
